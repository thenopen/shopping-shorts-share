{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "AUTO-GENERATED by scripts/gen-schema.py — 수동 수정 금지. 진실 소스 = packages/core/app/server_api.py Pydantic 모델 + app/voices.py. 코드 변경 후 python scripts/gen-schema.py 재실행.",
  "title": "ShortsJob",
  "description": "쇼츠 변환 작업 요청/상태. 웹·데스크톱·서버·core 공유. 요청 모델별 스키마는 $defs 참조.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "작업 ID(uuid.uuid4().hex[:8])"
    },
    "status": {
      "type": "string",
      "description": "작업 상태. waiting_gpu=GPU 대기. analyzed/transcribed=단계 완료(이어하기 가능).",
      "enum": [
        "queued",
        "downloading",
        "removing_subtitle",
        "waiting_gpu",
        "analyzed",
        "transcribing",
        "transcribed",
        "dubbing",
        "captioning",
        "composing",
        "overlaying",
        "done",
        "error"
      ]
    },
    "progress": {
      "type": "integer",
      "description": "현재 단계 기준 0~100(전체 파이프라인 아님).",
      "minimum": 0,
      "maximum": 100
    },
    "stage": {
      "type": "string",
      "description": "현재 단계 표시용 한글 문구."
    },
    "preview": {
      "type": [
        "string",
        "null"
      ],
      "description": "분석 중간 결과 영상 URL."
    },
    "output": {
      "type": [
        "string",
        "null"
      ],
      "description": "최종 영상 URL."
    },
    "output_dur": {
      "type": [
        "number",
        "null"
      ],
      "description": "최종 영상 실측 길이(초)."
    },
    "has_speech": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "대본에 의미 있는 음성이 있는지(4자 이상)."
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "description": "오류 메시지(status=error 일 때)."
    },
    "created": {
      "type": "number",
      "description": "생성 시각(unix epoch)."
    },
    "reused": {
      "type": "boolean",
      "description": "라이브러리 캐시 재사용 여부."
    },
    "meta": {
      "type": "object",
      "description": "부가 메타(url/title/source/transcribe 진단 등)."
    },
    "url": {
      "type": "string",
      "description": "원본 영상 링크(도우인/틱톡/일반)"
    },
    "script": {
      "default": "",
      "type": "string",
      "description": "한국어 대본(빈 값=원음 유지/무음)"
    },
    "engine": {
      "default": "typecast",
      "type": "string",
      "enum": [
        "typecast",
        "elevenlabs",
        "google"
      ],
      "description": "TTS 엔진. 기본 typecast."
    },
    "voice": {
      "default": "",
      "type": "string",
      "description": "엔진별 voice_id. 빈 값=엔진 기본. 닉네임 기반 google 경로는 voices.py 23개 사용."
    },
    "speaking_rate": {
      "default": 1.0,
      "type": "number",
      "description": "TTS 배속(1.0=보통).",
      "minimum": 0.5,
      "maximum": 2.0
    },
    "emotion": {
      "default": "smart",
      "type": "string",
      "enum": [
        "smart",
        "happy",
        "sad",
        "angry",
        "whisper",
        "toneup",
        "tonedown",
        "normal"
      ],
      "description": "Typecast 감정 프리셋. smart=문맥 자동."
    },
    "cta": {
      "default": "profile",
      "type": "string",
      "enum": [
        "comment",
        "profile",
        "link"
      ],
      "description": "CTA 문구 프리셋. 사전 정의 외 문자열이면 그 텍스트 그대로 사용."
    },
    "subtitle_backend": {
      "default": "modal",
      "type": "string",
      "enum": [
        "modal",
        "local"
      ],
      "description": "자막·워터마크 제거 백엔드. modal=클라우드(기본), local=로컬 GPU(ALLOW_LOCAL_GPU=1 필요)."
    },
    "subtitle_engine": {
      "type": "string",
      "enum": [
        "propainter_modal",
        "propainter_local",
        "lama",
        "lama_fallback",
        "cached",
        "none"
      ],
      "description": "실제 자막제거에 쓰인 엔진(응답 전용)."
    }
  },
  "required": [
    "id",
    "status"
  ],
  "$defs": {
    "AnalyzeReq": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "원본 영상 링크(도우인/틱톡/일반)"
        },
        "subtitle_backend": {
          "default": "modal",
          "type": "string",
          "enum": [
            "modal",
            "local"
          ],
          "description": "자막·워터마크 제거 백엔드. modal=클라우드(기본), local=로컬 GPU(ALLOW_LOCAL_GPU=1 필요)."
        },
        "reuse_nosub": {
          "default": true,
          "type": "boolean",
          "description": "캐시된 자막제거본 재사용(False=강제 재처리)."
        }
      }
    },
    "TranscribeReq": {
